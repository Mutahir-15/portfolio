# Backend Environment Variables
# Copy this file to .env and fill in the values

# Required: API key for Google Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Required: API key for Resend email service (https://resend.com/api-keys)
RESEND_API_KEY=your_resend_api_key_here

# Required: Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000

# Optional: Enable debug mode (default: false)
DEBUG=true

# Optional: Server port (default: 8000)
PORT=8000

# Optional: Environment name (development, production)
ENVIRONMENT=development
